<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageType>Template</PackageType>
        <Version>1.3.15</Version>
        <PackageId>Perigon.templates</PackageId>
        <Title>Perigon Templates</Title>
        <Authors>Ater.NilTor</Authors>
        <Description>
            Well-structured fast development templates based on ASP.NET Core / Aspire
        </Description>
        <PackageTags>dotnet-new;templates;webapi;minimal-api;nativeaot;framework;aspire;ai</PackageTags>
        <TargetFramework>netstandard2.1</TargetFramework>
        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <ContentTargetFolders>content</ContentTargetFolders>
        <PackageOutputPath>nuget</PackageOutputPath>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Product>Perigon.templates</Product>
        <PackageProjectUrl>https://github.com/AterDev/Perigon.template</PackageProjectUrl>
        <PackageIcon>logo.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/AterDev/Perigon.template</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>1. Keep repository maintenance Product Design, Plan Task, ProjectTracking and Changelog records under the repository root; retain only the baseline starter documents intended for generated projects in ApiStandard and MiniApi templates.
2. Add MiniApi-specific Minimal API and Native AOT skills covering endpoint generation, trimming, serialization, dependency review, testing, and completion gates.
3. Align test database configuration and cleanup with each template's AppHost testing database, including guarded cleanup of the resolved test database.
        </PackageReleaseNotes>
        <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
        <NoDefaultExcludes>true</NoDefaultExcludes>
    </PropertyGroup>
    <PropertyGroup>
        <!-- 定义通用排除模式 -->
        <StandardExcludes>
            **\bin\**;**\obj\**;**\.vs\**;**\node_modules\**;**\.angular\**;**\*.lock;**\pnpm-lock.yaml;**\dist\**;ApiStandard\src\Perigon\Perigon.AspNetCore.SourceGeneration\**;MiniApi\src\Perigon\Perigon.AspNetCore.SourceGeneration\**</StandardExcludes>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="ApiStandard\**\*"
            Exclude="$(StandardExcludes);ApiStandard\templates\**;ApiStandard\src\Modules\**;ApiStandard\test\ManagerBaseTests\**" />
        <Content Include="MiniApi\**\*"
            Exclude="$(StandardExcludes);MiniApi\templates\**;MiniApi\src\Modules\**;MiniApi\test\ManagerBaseTests\**" />
        <Compile Remove="**\*" />
        <EmbeddedResource Remove="**\*" />
        <None Update="logo.png">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Update="README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>
</Project>
