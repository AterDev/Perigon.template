<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<NoWarn>1701;1702;1591</NoWarn>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>4c7b2d64-0f27-42bb-8d0f-6f3ddf6ed6e5</UserSecretsId>
		<IsAotCompatible>true</IsAotCompatible>
		<EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
				<InvariantGlobalization>false</InvariantGlobalization>
			</PropertyGroup>
			<!-- AOT/容器发布配置仅在 Release 生效，本地 Debug 调试使用当前平台输出 -->
			<PropertyGroup Condition="'$(Configuration)' == 'Release'">
				<PublishAot>true</PublishAot>
				<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
				<SelfContained>true</SelfContained>
				<StripSymbols>true</StripSymbols>
			</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
		<PackageReference Include="Microsoft.AspNetCore.SpaProxy"
			Condition="'$(Configuration)' == 'Debug'" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Perigon.AspNetCore.SourceGeneration" PrivateAssets="all" />
		<ProjectReference Include="..\..\Definition\ServiceDefaults\ServiceDefaults.csproj" />
		<ProjectReference Include="..\..\Modules\CommonMod\CommonMod.csproj" />
	</ItemGroup>

</Project>
