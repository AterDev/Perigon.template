{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Components": {
    "UseCors": true,
    "AuthType": "Jwt",
    "MQType": "None",
    "UseSMS": false,
    "UseSmtp": false,
    "UseAWSS3": false,
    "UseOpenAPI": true
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowedSubdomains": false
  },
  "Authentication": {
    "Jwt": {
      "ValidAudiences": "AdminService",
      "ValidIssuer": "https://localhost:7070",
      "Sign": "",
      "ExpiredSecond": 7200,
      "RefreshExpiredSecond": 604800
    },
    "OAuth": {
      "Authority": "https://localhost:7070",
      "Audiences": [ "AdminService" ],
      "ClientId": "AdminService",
      "ValidateAudience": true,
      "RequireHttpsMetadata": true
    },
    "Microsoft": {
      "ClientId": null,
      "ClientSecret": null,
      "CallbackUrl": "/your/callback/"
    },
    "Google": {
      "ClientId": null,
      "ClientSecret": null,
      "CallbackUrl": "/your/callback"
    }

  },
  "Cache": {
    "MaxPayloadBytes": 1048576,
    "MaxKeyLength": 1024,
    "Expiration": 20,
    "LocalCacheExpiration": 10
  }
}
