{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Components": {
    "AuthType": "Jwt",
    "MQType": "None",
    "UseSMS": false,
    "UseSmtp": false,
    "UseAWSS3": false
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowedSubdomains": false
  },
  "Authentication": {
    "Jwt": {
      "ValidAudiences": "ApiService",
      "ValidIssuer": "https://localhost:7070",
      "Sign": "",
      "ExpiredSecond": 7200,
      "RefreshExpiredSecond": 604800 
    },
    "OAuth": {
      "Authority": "https://localhost:7070",
      "Audiences": [ "AdminService" ],
      "ClientId": "ApiService",
      "ValidateAudience": true,
      "RequireHttpsMetadata": true
    },
    "Microsoft": {
      "ClientId": null,
      "ClientSecret": null,
      "CallbackUrl": "/your/callback/"
    },
    "Google": {
      "ClientId": null,
      "ClientSecret": null,
      "CallbackUrl": "/your/callback"
    }

  },
  "Cache": {
    "MaxPayloadBytes": 1048576,
    "MaxKeyLength": 1024,
    "Expiration": 20,
    "LocalCacheExpiration": 10
  },

  "LoginSecurityPolicy": {
    "PasswordLevel": 0,
    "IsNeedVerifyCode": false,
    "PasswordExpired": 365,
    "LoginRetry": 5,
    "SessionLevel": 0,
    "IsEnable": false
  },
  "Smtp": {
    "Host": "",
    "Port": 25,
    "DisplayName": "",
    "From": "",
    "Username": "",
    "Password": "",
    "EnableSsl": true
  },
  "SMS": {
    "AccessKeyId": "",
    "AccessKeySecret": "",
    "Sign": ""
  },
  "AWSS3": {
    "Endpoint": "",
    "AccessKeyId": "",
    "AccessKeySecret": "",
    "BucketName": "",
    "Region": ""
  }
}
