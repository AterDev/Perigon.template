<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IsRoslynComponent>true</IsRoslynComponent>
		<PackageId>Perigon.AspNetCore.SourceGeneration</PackageId>
		<Title>Perigon.AspNetCore.SourceGeneration</Title>
		<Authors>niltor</Authors>
		<Version>1.1.4</Version>
		<PackageTags>analyzer;web framework;ater;webapi;source generator</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/AterDev/Perigon.template</PackageProjectUrl>
		<PackageIcon>logo.png</PackageIcon>
		<RepositoryUrl>https://github.com/AterDev/Perigon.template</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>Register host-provided ModuleDemand implementations in generated AddModules.</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<AnalysisLevel>none</AnalysisLevel>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
		<Description>Roslyn source generator for Perigon Web API projects, generating manager, module, Minimal API endpoint registration helpers and Localizer constant keys.</Description>
		<NeutralLanguage>en</NeutralLanguage>
		<IncludeBuildOutput>false</IncludeBuildOutput>
	</PropertyGroup>
	<ItemGroup>
		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Update="Perigon.AspNetCore.SourceGeneration.targets" Pack="true" PackagePath="build/Perigon.AspNetCore.SourceGeneration.targets" />
		<ProjectReference Include="..\..\..\..\Perigon.AspNetCore.SourceGeneration.Build\Perigon.AspNetCore.SourceGeneration.Build.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<None Update="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<Target Name="PrepareSourceGenerationBuildTask" BeforeTargets="_GetPackageFiles">
		<MSBuild Projects="..\..\..\..\Perigon.AspNetCore.SourceGeneration.Build\Perigon.AspNetCore.SourceGeneration.Build.csproj"
		         Targets="Build"
		         Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0" />
		<ItemGroup>
			<None Include="..\..\..\..\Perigon.AspNetCore.SourceGeneration.Build\bin\$(Configuration)\netstandard2.0\**\*.dll"
			      Pack="true"
			      PackagePath="build/"
			      Visible="false" />
		</ItemGroup>
	</Target>
</Project>
